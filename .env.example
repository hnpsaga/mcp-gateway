# =============================================================================
# MCP Gateway – Environment Configuration
# =============================================================================
# Copy this file to .env and adjust for your environment:
#   cp .env.example .env
#
# All variables are optional – defaults are shown in comments.
# In Docker/container environments, prefer setting these via the runtime
# environment rather than baking them into the image.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# TCP port the server listens on.
PORT=3000

# IP address to bind to.
# Use 127.0.0.1 for local-only access (default for non-container runs).
# Use 0.0.0.0 to accept connections on all interfaces (required in containers).
HOST=127.0.0.1

# Application environment: development | production | test
NODE_ENV=development

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# Pretty-print logs (human-readable). Disable in production for JSON output.
# true | false (default: false)
LOG_PRETTY=false

# Emit structured JSON logs. Recommended true in production.
# true | false (default: true)
LOG_STRUCTURED=true

# -----------------------------------------------------------------------------
# Metrics
# -----------------------------------------------------------------------------
# Enable Prometheus metrics endpoint at /metrics.
# true | false (default: true)
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# OpenTelemetry (OTEL)
# -----------------------------------------------------------------------------
# Enable OpenTelemetry tracing.
# true | false (default: false)
OTEL_ENABLED=false

# OTEL service name (used in trace metadata). Standard OTel env var.
# OTEL_SERVICE_NAME=mcp-gateway

# OTLP exporter endpoint. Standard OTel env var.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# -----------------------------------------------------------------------------
# Transport Configuration
# These control timeouts and buffer sizes for MCP server connections.
# -----------------------------------------------------------------------------
# Log level for the transport layer (default: info)
# TRANSPORT_LOG_LEVEL=info

# Maximum JSON-RPC message size in bytes (default: 1048576 = 1 MB)
# TRANSPORT_MAX_MESSAGE_SIZE=1048576

# Maximum stdout buffer size in bytes (default: 10485760 = 10 MB)
# TRANSPORT_STDOUT_BUFFER_SIZE=10485760

# Maximum stderr buffer size in bytes (default: 1048576 = 1 MB)
# TRANSPORT_STDERR_BUFFER_SIZE=1048576

# Maximum concurrent pending JSON-RPC requests per session (default: 100)
# TRANSPORT_MAX_CONCURRENT_REQUESTS=100

# Process startup timeout in milliseconds (default: 15000 = 15 s)
# TRANSPORT_PROCESS_STARTUP_TIMEOUT=15000

# MCP initialize handshake timeout in milliseconds (default: 15000 = 15 s)
# TRANSPORT_INITIALIZE_TIMEOUT=15000

# Total connection timeout in milliseconds (default: 30000 = 30 s)
# TRANSPORT_CONNECTION_TIMEOUT=30000

# Graceful disconnect timeout in milliseconds (default: 5000 = 5 s)
# TRANSPORT_DISCONNECT_TIMEOUT=5000

# -----------------------------------------------------------------------------
# Database Configuration (SQLite)
# -----------------------------------------------------------------------------
# Directory where the SQLite database file is stored (default: ./data)
DATABASE_PATH=./data

# SQLite database filename (default: mcp-gateway.db)
DATABASE_FILENAME=mcp-gateway.db

# Enable WAL (Write-Ahead Logging) mode for better concurrent read performance.
# Recommended true for production (default: true)
DATABASE_WAL_MODE=true

# SQLite busy timeout in milliseconds before returning SQLITE_BUSY (default: 5000)
DATABASE_BUSY_TIMEOUT=5000

# -----------------------------------------------------------------------------
# Authentication Configuration
# Authentication is disabled by default. Enable it in production.
# -----------------------------------------------------------------------------
# Enable API key authentication for all endpoints.
# true | false (default: false)
AUTH_ENABLED=false

# Comma-separated list of valid API keys.
# Generate strong keys: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_KEYS=your-api-key-1,your-api-key-2

# HTTP header name used to pass the API key (default: x-api-key)
# AUTH_HEADER_NAME=x-api-key

# Allow the API key to be passed via Authorization: Bearer <key> header.
# true | false (default: false)
# AUTH_BEARER_ENABLED=false

# Require authentication to access Swagger UI and OpenAPI spec (/documentation).
# Recommended true in production when AUTH_ENABLED=true.
# true | false (default: false)
# AUTH_SWAGGER_AUTHENTICATE=false
