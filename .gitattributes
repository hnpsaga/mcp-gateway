# Auto-detect text files and normalize line endings
* text=auto

# Shell scripts must have LF line endings
*.sh text eol=lf

# YAML files must have LF line endings
*.yaml text eol=lf
*.yml text eol=lf

# Node.js ecosystem files
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf

# Markdown files
*.md text eol=lf

# Editor config
.editorconfig text eol=lf

# Git config
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary files - treat as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
